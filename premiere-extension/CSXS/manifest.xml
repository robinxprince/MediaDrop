<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0" ExtensionBundleId="com.mediadrop.suite"
                   ExtensionBundleVersion="1.0.0" ExtensionBundleName="MediaDrop Suite"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.mediadrop.backend" Version="1.0.0" />
    <Extension Id="com.mediadrop.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList><Locale Code="All" /></LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <!-- 1. Headless Background HTTP Bridge (Auto-starts on launch) -->
    <Extension Id="com.mediadrop.backend">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-running-insecure-content</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size>
              <Width>10</Width>
              <Height>10</Height>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

    <!-- 2. UI Status & Control Panel (Window > Extensions > MediaDrop) -->
    <Extension Id="com.mediadrop.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./panel.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <!-- On some Windows graphics drivers the panel draws as garbled lines; it needs no GPU -->
            <Parameter>--disable-gpu</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>MediaDrop</Menu>
          <Geometry>
            <Size>
              <Width>320</Width>
              <Height>380</Height>
            </Size>
            <MinSize>
              <Width>280</Width>
              <Height>260</Height>
            </MinSize>
            <MaxSize>
              <Width>600</Width>
              <Height>800</Height>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
